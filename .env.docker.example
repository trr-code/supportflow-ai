# Copy to .env.docker; use docker compose --env-file .env.docker ...
# Generate a separate APP_KEY and a random database password locally.
APP_NAME="Lucid Docker"
APP_KEY=
LUCID_DB_PASSWORD=
LOG_CHANNEL=stderr
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=false
OPENAI_TRIAGE_MODEL=gpt-5.6-luna
OPENAI_REPLY_MODEL=gpt-5.6-terra
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
