APP_NAME="SupportFlow AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://supportflow-ai.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=supportflow_ai
DB_USERNAME=root
DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@harborandco.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required for local seed, indexing, and retrieval — the same OpenAI path as production.
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=true
OPENAI_TRIAGE_MODEL=gpt-5.6-luna
OPENAI_REPLY_MODEL=gpt-5.6-terra
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# OPENAI_SMOKE=false

# Opt-in Pest Stressless HTTP runs. Never set STRESS=true in CI.
# Staging Forge (off-peak, smoke first): https://supportflow-ai-ou1b5gvy.on-forge.com
# STRESS=false
# STRESS_URL=https://supportflow-ai.test
# STRESS_MAX_CONCURRENCY=16
# k6 resets cookies each VU iteration unless this is true. Pest Stress tests set it automatically.
# K6_NO_COOKIES_RESET=true

# Optional Laravel Octane. Production/Forge uses Linux FrankenPHP behind Nginx.
# Native Windows FrankenPHP is not the documented Octane path (use Docker).
# OCTANE_SERVER=frankenphp
# OCTANE_HTTPS=false

DEMO_STALE_MINUTES=45
SUPPORTFLOW_MIN_SIMILARITY=0.45
SUPPORTFLOW_COMPANY="Harbor & Co"
SUPPORTFLOW_PRODUCT="Harbor Outfitters"
SUPPORTFLOW_AGENT_NAME="Alex Rivera"
SUPPORTFLOW_AGENT_EMAIL="alex.rivera@harborandco.example"
